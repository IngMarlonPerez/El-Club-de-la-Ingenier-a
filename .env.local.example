GROQ_API_KEY=tu_clave_de_groq_aqui
# openrouter.ai/keys → Create Key. Segundo respaldo cuando se agota la cuota de Groq.
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
# console.nvidia.com/build → API Keys. Tercer respaldo (cupo fijo, no se renueva por día).
NVIDIA_API_KEY=tu_clave_de_nvidia_aqui
# Presupuesto diario por proveedor (mensajes/día). Ajusta según tu cuota real.
GROQ_DAILY_LIMIT=500
OPENROUTER_DAILY_LIMIT=45
NVIDIA_DAILY_LIMIT=300

# Panel de Supabase → Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Secreta de verdad — NUNCA la expongas al cliente. Se usa en pages/api/join.js y pages/api/chat.js
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Buscador de Empleo (pages/api/jobs/search.js) — jooble.org/api/about, registro gratis
JOOBLE_API_KEY=tu_clave_de_jooble_aqui
JOB_CACHE_TTL_HOURS=1
JOB_SCRAPER_CRON_HOURS=6
# Protege pages/api/cron/scrape-jobs.js — Vercel Cron la envía sola si está configurada
# en las variables de entorno del proyecto (no hace falta pegarla en ningún otro lado)
CRON_SECRET=genera_un_valor_aleatorio_largo_aqui

# Opcional — monitoreo de errores (sentry.io, plan gratuito). Sin estas dos, Sentry
# simplemente no envía nada; no rompe el build ni el sitio.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

